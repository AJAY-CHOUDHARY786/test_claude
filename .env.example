# Copy to .env and fill in. NEVER commit .env and never paste real values into chat.
# Values for the Shopify variables come from your Shopify Dev Dashboard / Partner Dashboard,
# or are set automatically by `shopify app dev`.

NODE_ENV=development
LOG_LEVEL=info

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=
SHOPIFY_APP_URL=

# PostgreSQL connection string, for example:
# postgresql://USER:<password>@HOST:5432/DATABASE
DATABASE_URL=

# Optional: the handle of your app as shown in the Partner Dashboard (used for the plan-selection link).
SHOPIFY_APP_HANDLE=

# Email. "sink" logs instead of sending, which is the safe default. Use "resend" only when you approve real sending.
EMAIL_MODE=sink
EMAIL_FROM=
RESEND_API_KEY=

# Optional photo storage (any S3-compatible service). Leave all blank to keep photo uploads off.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Shown on the Help page. Set your real support address; the app never invents one.
SUPPORT_EMAIL=

# Optional: signing secret for delivery/bounce events from your email provider (Resend webhooks -> /webhooks/email).
RESEND_WEBHOOK_SECRET=
