{
  "name": "product-reviews-app",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19 <21 || >=22.12"
  },
  "scripts": {
    "build": "prisma generate && react-router build",
    "dev": "shopify app dev",
    "start": "node server.js",
    "worker": "tsx app/jobs/run.ts",
    "setup": "prisma generate && prisma migrate deploy",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test \"test/*.test.ts\"",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:schema": "node scripts/check-prisma-schema.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "shopify": "shopify",
    "deploy": "shopify app deploy",
    "test:widget": "node test/widget.browser.mjs",
    "db:init": "prisma migrate dev --name init",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "verify": "npm run check:schema && npm run test && npm run check:secrets && npm run typecheck && npm run lint && npm run build",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "render:constraints": "node scripts/render-constraints.mjs",
    "check:tenant": "node scripts/check-tenant-scope.mjs",
    "db:constraints": "prisma db execute --file prisma/constraints.sql --schema prisma/schema.prisma",
    "test:db": "node --test \"test-db/*.test.ts\"",
    "verify:phase3": "node scripts/verify-phase3.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/client": "^6.0.0",
    "@react-router/express": "^7.9.0",
    "@react-router/fs-routes": "^7.9.0",
    "@react-router/node": "^7.9.0",
    "@shopify/shopify-app-react-router": "latest",
    "@shopify/shopify-app-session-storage-prisma": "latest",
    "@vercel/react-router": "^1.3.7",
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "isbot": "^5.1.0",
    "prisma": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.9.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.0",
    "@shopify/app-bridge-types": "latest",
    "@shopify/polaris-types": "latest",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.15.0",
    "playwright": "^1.49.0",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.0"
  }
}
